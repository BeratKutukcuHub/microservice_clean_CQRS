{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "SecretKey": "default-secret-key-will-be-overridden",
    "Issuer": "CleanArchitecture",
    "Audience": "CleanArchitecture"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "product_exchange",
    "ExchangeType": "topic",
    "QueueName": "product_queue",
    "RetryCount": 3,
    "RetryDelaySeconds": 5,
    "MessageTTLMinutes": 60,
    "EnableDeadLetterExchange": true
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultExpirationMinutes": 30,
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "ProductService:"
    }
  }
}
