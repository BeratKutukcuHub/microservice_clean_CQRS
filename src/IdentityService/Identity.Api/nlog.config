<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${specialfolder:folder=LocalApplicationData}/CleanArthitecture_Microservices/logs/internal-nlog.log">

  <targets>
    <target xsi:type="AsyncWrapper"
            name="asyncFile"
            queueLimit="10000"
            overflowAction="Discard">

      <target xsi:type="File"
              fileName="${basedir}/logs/app-${shortdate}.log"
              archiveEvery="Day"
              archiveNumbering="Rolling"
              maxArchiveFiles="14"
              keepFileOpen="false"
              concurrentWrites="true"
              encoding="utf-8">

<layout xsi:type="JsonLayout" includeAllProperties="true">
  <attribute name="timestamp" layout="${date:format=o}" />
  <attribute name="level" layout="${level:uppercase=true}" />
  <attribute name="logger" layout="${logger}" />
  <attribute name="message" layout="${message}" />
  <attribute name="properties" layout="${all-event-properties:format=json}" />
  <attribute name="exception"
             layout="${exception:format=type,message,stacktrace}"
             omitEmpty="true" />

  <attribute name="correlationId"
             layout="${scopeproperty:item=correlationId}" />

  <attribute name="context"
             layout="${scopeproperty:item=context}" />
</layout>
      </target>
    </target>

    <target xsi:type="Console" name="console">
      <layout>
        ${longdate}|${level:uppercase=true}|${logger}|${mdlc:item=correlationId}|${message}
        ${onexception:inner=${newline}${exception:format=toString}}
      </layout>
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="console" />
    <logger name="IdentityService.*" minlevel="Info" writeTo="asyncFile" />
    <logger name="*" minlevel="Error" writeTo="asyncFile" />
  </rules>

</nlog>
