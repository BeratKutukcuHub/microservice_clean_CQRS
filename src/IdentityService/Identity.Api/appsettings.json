{
  "MongoDB": {
    "ConnectionString": "mongodb://mongodb:27017",
    "DatabaseName": "IdentityDatabase"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "SecretKey": "DBLOGHANDLEYourSecretKey123456789",
    "Issuer": "CleanArchitecture",
    "Audience": "CleanArchitecture"
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "identity_exchange",
    "ExchangeType": "topic",
    "QueueName": "identity_queue",
    "RetryCount": 3,
    "RetryDelaySeconds": 5,
    "MessageTTLMinutes": 60,
    "EnableDeadLetterExchange": true
  }
}
