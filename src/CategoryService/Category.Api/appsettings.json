{
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "CategoryServiceDb"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "SecretKey": "DBLOGHANDLEYourSecretKey123456789",
    "Issuer": "CleanArchitecture",
    "Audience": "CleanArchitecture"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "category_exchange",
    "ExchangeType": "topic",
    "QueueName": "category_queue",
    "RetryCount": 3,
    "RetryDelaySeconds": 5,
    "MessageTTLMinutes": 60,
    "EnableDeadLetterExchange": true
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultExpirationMinutes": 30
  }
}