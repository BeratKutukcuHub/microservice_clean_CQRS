{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "mailnotification_exchange",
    "ExchangeType": "topic",
    "QueueName": "mailnotification_queue",
    "RetryCount": 3,
    "RetryDelaySeconds": 5,
    "MessageTTLMinutes": 60,
    "EnableDeadLetterExchange": true
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultExpirationMinutes": 30
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "your-email@gmail.com",
    "Password": "your-app-password"
  }
}
